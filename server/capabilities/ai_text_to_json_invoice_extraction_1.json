    "required": [
      "invoice_text"
    ],
    "type": "object",
    "properties": {
      "invoice_text": {
        "description": "包含发票信息的纯文本内容",
        "type": "string"
      }
    }
  },
  "formValue": {
    "prompt": "你是一位专业的财务票据处理专家，请从以下发票文本中提取指定字段信息。如果某个字段不存在或无法识别，请填空字符串。文本内容：{{input.invoice_text}}",
    "jsonStructure": [
      {
        "name": "invoiceNumber",
        "paramDescription": "发票号码",
        "paramType": "String"
      },
      {
