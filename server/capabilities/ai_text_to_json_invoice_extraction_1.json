        "paramDescription": "发票金额",
        "paramType": "Number"
      },
      {
        "paramDescription": "货币类型，如CNY、USD、EUR等",
        "paramType": "String",
        "name": "currency"
      },
      {
        "paramDescription": "汇率，如无则填0",
        "paramType": "Number",
        "name": "exchangeRate"
      },
      {
        "paramType": "String",
        "name": "vendor",
        "paramDescription": "供应商名称"
      },
      {
        "name": "invoiceDate",
        "paramDescription": "开票日期，格式为YYYY-MM-DD",
        "paramType": "String"
      },
      {
        "paramDescription": "项目编码",
        "paramType": "String",
        "name": "projectCode"
      }
    ],
    "modelID": "2015",
    "modelParams": {
      "maxTokens": 8192,
      "temperature": 0.5
    }
  },
